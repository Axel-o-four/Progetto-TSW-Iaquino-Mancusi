<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
  <display-name>Pixel Emporium</display-name>
  <welcome-file-list>
    <welcome-file>CatalogView.jsp</welcome-file>
  </welcome-file-list>
  <resource-ref>
    <description>JNDI reference to a data source</description>
    <res-ref-name>jdbc/pixel_emporium</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  <servlet>
    <servlet-name>GiocoControl</servlet-name>
    <servlet-class>it.unisa.GiocoControl</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>ConsoleControl</servlet-name>
    <servlet-class>it.unisa.ConsoleControl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>GiocoControl</servlet-name>
    <url-pattern>/GiocoControl</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ConsoleControl</servlet-name>
    <url-pattern>/ConsoleControl</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>AccessorioControl</servlet-name>
    <servlet-class>it.unisa.AccessorioControl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AccessorioControl</servlet-name>
    <url-pattern>/AccessorioControl</url-pattern>
  </servlet-mapping>
	<servlet>
		<servlet-name>LoginServlet</servlet-name>
		<servlet-class>it.unisa.LoginServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>LoginServlet</servlet-name>
		<url-pattern>/Login</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>RegistrationServlet</servlet-name>
		<servlet-class>it.unisa.RegistrationServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>RegistrationServlet</servlet-name>
		<url-pattern>/Register</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>LogoutServlet</servlet-name>
		<servlet-class>it.unisa.LogoutServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>LogoutServlet</servlet-name>
		<url-pattern>/Logout</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>UserControl</servlet-name>
		<servlet-class>it.unisa.UserControl</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>UserControl</servlet-name>
		<url-pattern>/UserControl</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>OrdineControl</servlet-name>
		<servlet-class>it.unisa.OrdineControl</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>OrdineControl</servlet-name>
		<url-pattern>/OrdineControl</url-pattern>
	</servlet-mapping>
</web-app>